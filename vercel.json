{
  "buildCommand": null,
  "outputDirectory": "site",
  "functions": {
    "api/quote.js": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/quotes.js": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/api/(quote|quotes)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=30, s-maxage=60" }]
    },
    {
      "source": "/(.*)\\.(js|css|svg|png|json)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ]
}
